PORT=3000
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Optional Cloudflare R2 storage (leave unset for local-only development)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=ss-study-centre-media
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional: public custom domain or R2.dev URL mapped to the bucket root.
# Recommended for video playback so large media does not pass through the app server.
# R2_PUBLIC_URL=https://media.example.com
# Optional: defaults to _system/content.json
# R2_DATA_KEY=_system/content.json
# Push notifications (optional)
# VAPID_SUBJECT=mailto:your-email@example.com
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
